---
// The routing table, as `delegation-route table --json` (schema 3) returns it
// for a fresh default preset. One row per (profile, role): what the adapter
// supports today is the only thing that decides.
import table from '../data/routing-table.json';
import kit from '../data/kit.json';
import StatusPill from './StatusPill.astro';

type Row = {
  profile: string;
  model: string;
  family: string | null;
  adapter: string;
  lane: string;
  technical_compatibility: boolean;
  capabilities: string[];
  selection: string;
};
const rows = table.profiles as Row[];
const profileConfig = kit.profileConfig as Record<string, { parameters?: { effort?: string } }>;
let previous = '';
---

<div class="overflow-x-auto -mx-6 px-6">
  <table class="w-full text-[0.76rem] leading-snug border-collapse">
    <thead>
      <tr class="eyebrow text-left border-b border-[var(--color-line-strong)]">
        <th class="py-2 pr-4 font-normal whitespace-nowrap"
          >Profile · model / adapter / effort · capabilities</th
        >
        <th class="py-2 pr-4 font-normal whitespace-nowrap">Role</th>
        <th class="py-2 font-normal whitespace-nowrap">Adapter today</th>
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row) => {
          const first = row.profile !== previous;
          previous = row.profile;
          const effort = profileConfig[row.profile]?.parameters?.effort ?? '—';
          return (
            <tr
              class:list={[
                'border-b border-[var(--color-line)] hover:bg-[var(--color-panel)] align-top',
                first && 'border-t border-t-[var(--color-line-strong)]'
              ]}
            >
              <td class="py-1.5 pr-4 whitespace-nowrap">
                {first && (
                  <>
                    <span class="font-mono font-medium">{row.profile}</span>
                    <span class="block font-mono text-[0.7rem] text-[var(--color-ink-soft)]">
                      {row.model} / {row.adapter} / {effort} · {row.capabilities.join(', ')}
                    </span>
                  </>
                )}
              </td>
              <td class="py-1.5 pr-4 whitespace-nowrap">{row.lane}</td>
              <td class="py-1.5 whitespace-nowrap">
                <StatusPill kind="compat" value={row.technical_compatibility} />
              </td>
            </tr>
          );
        })
      }
    </tbody>
  </table>
</div>
