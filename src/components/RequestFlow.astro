    <text x="187" y="545" class="mid">glm</text>
    <rect x="150" y="580" width="74" height="22" class="idle dash a-pulse"></rect>
    <text x="187" y="595" class="mid sm soft">empty</text>
    <g class="a-floor">
      <path d="M34 604 H232" class="floor-bar"></path>
      <path d="M23 598 L32 604 L23 610 Z" class="floor-tri"></path>
    </g>
    <text x="24" y="648" class="sm a-note">code: code-capable, ≥ small</text>
    <Fragment set:html={num(18, 448, 3)} />
    <path d="M236 629 V660" class="path" marker-end="url(#rfm-ai)"></path>

    <rect x="18" y="664" width="228" height="134" class="box a-cheap"></rect>
    <text x="34" y="690" class="ttl">cheapest</text>
