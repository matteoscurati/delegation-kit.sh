---
// Privacy-friendly analytics via Umami Cloud. Renders nothing unless both env
// vars are set, so analytics stay off in dev, in PR previews, and on any
// deploy that does not opt in. Set PUBLIC_UMAMI_WEBSITE_ID and
// PUBLIC_UMAMI_SCRIPT_URL as build variables on the Cloudflare Worker
// (`delegation-kit-sh` → Settings → Build → Build variables). See .env.example.
//
// The script URL is the first-party proxy at analytics.delegation-kit.sh
// (worker/); `data-host-url` makes the tracker POST events there too.
// `data-do-not-track` honours navigator.doNotTrack.
const websiteId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID;
const scriptUrl = import.meta.env.PUBLIC_UMAMI_SCRIPT_URL;
const enabled = Boolean(websiteId && scriptUrl);
const hostUrl = enabled ? new URL(scriptUrl).origin : '';
---

{
  enabled && (
    <script
      is:inline
      async
      defer
      src={scriptUrl}
      data-website-id={websiteId}
      data-host-url={hostUrl}
      data-do-not-track="true"
    />
  )
}
