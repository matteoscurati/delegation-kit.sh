---
// "Which model answers?": five requests into the same two models. No
// JavaScript: visually hidden radios and generated `:has()` rules that reveal
// one of five panels precomputed at build time by `route()` (tiered-v1, see
// example-pool.ts). A panel goes from display:none to block when it is
// selected, so its one-shot animation replays with no script. The sentence
// comes first and never animates; each SVG is aria-hidden and says the same.
import {
  glm,
  opus,
  route,
  priceTag,
  catalogVersion,
  type Profile,
  type Route,
  type Verdict,
  type Tier
} from '../lib/example-pool';

type Req = {
  id: string;
  label: string;
  v: Verdict;
  says: string;
  expect: Profile;
  text: (r: Route) => string;
};

const list = (r: Route) => r.candidates.map((p) => `${p.key} ${priceTag(p)}`).join(', ');

const requests: Req[] = [
  {
    id: 'rename',
    label: 'Rename foo to bar in utils.py',
    v: { difficulty: 1, tags: ['code'], confidence: 0.8 },
    says: '1 of 4 · code',
    expect: glm,
    text: (r) => `Easy, and code: the cheapest model good at code answers (${list(r)}).`
  },
  {
    id: 'race',
    label: 'Find the race condition in this scheduler',
    v: { difficulty: 3, tags: ['code'], confidence: 0.8 },
    says: '3 of 4 · code',
    expect: opus,
    text: () => 'Hard: only frontier will do, and opus is your only frontier model.'
  },
  {
    id: 'summarise',
    label: 'Summarise this contract',
    v: { difficulty: 2, tags: [], confidence: 0.8 },
    says: '2 of 4',
    expect: glm,
    text: () => 'Medium: mid is enough, so opus is not considered.'
  },
  {
    id: 'translate',
    label: 'Translate this paragraph into French',
    v: { difficulty: 1, tags: [], confidence: 0.8 },
    says: '1 of 4',
    expect: glm,
    text: () => 'Easy: small would do, but you have no small model. Next tier up: glm.'
  },
  {
    id: 'unanswered',
    label: 'A request the decider can’t answer',
    v: { difficulty: 1, tags: [], confidence: 0.8, failed: 'timeout' },
    says: 'no answer (timeout)',
    expect: glm,
    text: () => 'No answer: your default model, glm, replies; the response says so.'
  }
];

type State = { req: Req; r: Route };
const states: State[] = requests.map((req) => {
  const r = route(req.v, [glm, opus]);
  if (r.chosen !== req.expect)
    throw new Error(`LadderStepper: ${req.id} goes to ${r.chosen.key}, the copy says ${req.expect.key}`);
  return { req, r };
});

// --- the tier drawing ---------------------------------------------------
const Y: Record<Tier, number> = { frontier: 124, mid: 194, small: 264 };
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;');
const chipX = 200;
const chipW = 116;

function svg({ req, r }: State): string {
  const out: string[] = [];
  const isCand = (p: Profile) => r.candidates.includes(p);
  const late = r.climbed;
  const ansW = 26 + req.says.length * 10.5;
  const mid = `ls-aa-${req.id}`;

  // the decider's rating, and the default model when it can't answer
  out.push(`<text x="0" y="12" class="soft">decider's rating</text>`);
  out.push(
    `<g class="a-ans"><rect x="0" y="20" width="${ansW}" height="28" class="box"/><rect x="0" y="20" width="4" height="28" class="amberfill"/><text x="14" y="39" class="lg">${esc(req.says)}</text></g>`
  );
  if (r.undecidable) {
    out.push(
      `<rect x="270" y="20" width="126" height="28" class="defok a-defok"/><text x="333" y="39" class="mid">default: glm</text>`
    );
    out.push(`<path d="M${ansW + 4} 34 H266" pathLength="1" class="idle a-draw"/>`);
  }

  // tiers
  const dimmed = (t: Tier) => r.floor === 'frontier' && t !== 'frontier';
  for (const t of ['frontier', 'mid', 'small'] as Tier[]) {
    const y = Y[t];
    const parts: string[] = [];
    parts.push(`<path d="M0 ${y} H400" class="tierline"/>`);
    parts.push(`<text x="16" y="${y - 10}" class="soft sm">${t}</text>`);
    const occupant = t === 'frontier' ? opus : t === 'mid' ? glm : null;
    if (!occupant) {
      const pulse = late ? ' a-pulse' : '';
      parts.push(
        `<rect x="${chipX}" y="${y - 34}" width="${chipW}" height="26" class="idle dash${pulse}"/><text x="${chipX + chipW / 2}" y="${y - 16}" class="mid soft">empty</text>`
      );
    } else {
      // With no rating the default answers: drawn chosen, like every other answer.
      const chosen = r.chosen === occupant;
      const cand = isCand(occupant);
      let cls = 'chip';
      if (chosen) cls = `chosen ${late ? 'a-chosen-late' : 'a-chosen'}`;
      else if (cand) cls = 'settled a-settle';
      const textCls = chosen || cand ? 'mid' : 'mid soft';
      parts.push(
        `<rect x="${chipX}" y="${y - 34}" width="${chipW}" height="26" class="${cls}"/><text x="${chipX + chipW / 2}" y="${y - 16}" class="${textCls}">${occupant.key} · ${occupant.index.toFixed(1)}</text>`
      );
      if (cand || chosen)
        parts.push(
          `<text x="${chipX + chipW + 8}" y="${y - 16}" class="sm ${late ? 'a-price-late' : 'a-price'}">${priceTag(occupant)}</text>`
        );
    }
    out.push(dimmed(t) ? `<g class="dim">${parts.join('')}</g>` : parts.join(''));
  }

  // the needed tier, and the climb when it is empty
  if (r.floor) {
    const at = Y[r.floor];
    out.push(
      `<g class="a-floor"><path d="M0 ${at} H400" class="floorbar"/><path d="M0 ${at - 7} L9 ${at} L0 ${at + 7} Z" class="amberfill"/><text x="400" y="${at + 17}" class="end sm needed">needed tier</text></g>`
    );
    if (r.climbed)
      out.push(
        `<g class="a-arrow-late"><path d="M176 ${Y.small - 6} V${Y.mid + 10}" class="amber" marker-end="url(#${mid})"/><text x="184" y="${Y.mid + 24}" class="sm">none here: next tier up</text></g>`
      );
  }

  return `<svg class="dg ls" viewBox="0 0 400 296" aria-hidden="true" focusable="false"><defs><marker id="${mid}" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 z" fill="var(--color-explicit-strong)"/></marker></defs>${out.join('')}</svg>`;
}

// --- the selection rules ------------------------------------------------
const rid = (id: string) => `req-${id}`;
const rules: string[] = ['.stepper .lpanel{display:none}'];
for (const req of requests)
  rules.push(`.stepper:has(#${rid(req.id)}:checked) .lpanel[data-req="${req.id}"]{display:block}`);
const T = '2.6s';
const css = `
${rules.join('\n')}
@supports not selector(:has(*)){.stepper .lpanel{display:block;margin-bottom:2rem}}
.stepper .lane-option{display:inline-block;border:1px solid var(--color-line);padding:.35rem .6rem;cursor:pointer;font-family:var(--font-mono);font-size:.8rem;background:var(--color-panel)}
.stepper input:checked + .lane-option{background:var(--color-ink);color:var(--color-paper);border-color:var(--color-ink)}
.stepper input:focus-visible + .lane-option{outline:2px solid var(--color-ink);outline-offset:2px}
.stepper input{position:absolute;opacity:0;width:1px;height:1px;overflow:hidden}
.ls{max-width:30rem}
.ls text{font-size:14px}
.ls .sm{font-size:13px}
.ls .lg{font-size:15px;font-weight:500}
@media (max-width:639.98px){.ls text{font-size:16px}.ls .sm{font-size:15px}.ls .lg{font-size:17px}}
.ls .tierline{stroke:var(--color-ink);stroke-width:1}
.ls .amberfill{fill:var(--color-explicit)}
.ls .floorbar{stroke:var(--color-explicit-strong);stroke-width:3}
.ls .amber{stroke:var(--color-explicit-strong)}
.ls .needed{fill:var(--color-explicit-text);font-weight:500}
.ls .chosen{fill:var(--color-qualified-soft);stroke:var(--color-qualified);stroke-width:1.5}
.ls .settled{fill:var(--color-paper);stroke:var(--color-ink-soft);stroke-width:1.25}
.ls .defok{fill:var(--color-qualified-soft);stroke:var(--color-qualified);stroke-width:1.5}
.ls .dim .chip{stroke:var(--color-line)}
.ls .dim text{fill:var(--color-ink-soft)}
@media (prefers-reduced-motion:no-preference){
@keyframes ls-ans{0%{opacity:0;transform:translateX(-16px)}15%,100%{opacity:1;transform:none}}
@keyframes ls-floor{0%,15%{opacity:0;transform:translateY(-24px)}38%,100%{opacity:1;transform:none}}
@keyframes ls-arrow-late{0%,55%{opacity:0}64%,100%{opacity:1}}
@keyframes ls-pulse{0%,38%{stroke:var(--color-line);stroke-width:1.25}43%{stroke:var(--color-explicit-strong);stroke-width:2.5}47%{stroke:var(--color-line);stroke-width:1.25}51%{stroke:var(--color-explicit-strong);stroke-width:2.5}55%,100%{stroke:var(--color-line);stroke-width:1.25}}
@keyframes ls-price{0%,38%{opacity:0}50%,100%{opacity:1}}
@keyframes ls-price-late{0%,62%{opacity:0}69%,100%{opacity:1}}
@keyframes ls-settle{0%,38%{stroke:var(--color-line)}50%,69%{stroke:var(--color-ink)}85%,100%{stroke:var(--color-ink-soft)}}
@keyframes ls-chosen{0%,38%{fill:var(--color-paper);stroke:var(--color-line)}50%,69%{fill:var(--color-paper);stroke:var(--color-ink)}85%,100%{fill:var(--color-qualified-soft);stroke:var(--color-qualified)}}
@keyframes ls-chosen-late{0%,62%{fill:var(--color-paper);stroke:var(--color-line)}69%{fill:var(--color-paper);stroke:var(--color-ink)}85%,100%{fill:var(--color-qualified-soft);stroke:var(--color-qualified)}}
@keyframes ls-draw{0%,15%{stroke-dasharray:1 1;stroke-dashoffset:1}40%{stroke-dasharray:1 1;stroke-dashoffset:0}100%{stroke-dasharray:1 1;stroke-dashoffset:0}}
@keyframes ls-defok{0%,40%{fill:var(--color-paper);stroke:var(--color-line)}60%,100%{fill:var(--color-qualified-soft);stroke:var(--color-qualified)}}
.ls .a-ans{animation:ls-ans ${T} ease-out both}
.ls .a-floor{animation:ls-floor ${T} ease-out both}
.ls .a-arrow-late{animation:ls-arrow-late ${T} linear both}
.ls .a-pulse{animation:ls-pulse ${T} linear both}
.ls .a-price{animation:ls-price ${T} linear both}
.ls .a-price-late{animation:ls-price-late ${T} linear both}
.ls .a-settle{animation:ls-settle ${T} linear both}
.ls .a-chosen{animation:ls-chosen ${T} linear both}
.ls .a-chosen-late{animation:ls-chosen-late ${T} linear both}
.ls .a-draw{animation:ls-draw ${T} ease-out both}
.ls .a-defok{animation:ls-defok ${T} linear both}
}
`;
---

<style set:html={css}></style>

<div class="stepper grid gap-8 md:grid-cols-[minmax(0,1fr)_minmax(0,30rem)] md:items-start">
  <div class="min-w-0">
    <fieldset>
      <legend class="eyebrow mb-3">Pick a request</legend>
      <div class="flex flex-wrap gap-1.5 md:flex-col md:items-start">
        {
          requests.map((req, i) => (
            <span class="relative">
              <input
                type="radio"
                name="ladder-request"
                id={rid(req.id)}
                value={req.id}
                checked={i === 0}
                aria-describedby={`ls-s-${req.id}`}
              />
              <label for={rid(req.id)} class="lane-option">
                {req.label}
              </label>
            </span>
          ))
        }
      </div>
    </fieldset>
  </div>

  <div class="min-w-0" aria-live="polite">
    {
      states.map((s) => (
        <div class="lpanel" data-req={s.req.id}>
          <p id={`ls-s-${s.req.id}`} class="mb-5 text-xl text-[var(--color-ink)] max-w-[30rem]">
            {s.req.text(s.r)}
          </p>
          <Fragment set:html={svg(s)} />
        </div>
      ))
    }
  </div>
</div>

<p class="mt-6 font-mono text-[0.75rem] text-[var(--color-ink-soft)]">
  Estimated costs for a short request at {catalogVersion} prices; example ratings.
</p>
