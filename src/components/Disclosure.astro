---
// "Every response shows its work": the headers and the router object for the
// rename request, as text. The ink-circle markers in the gutter map each
// field to the flow step it records (aria-hidden; each marked line carries
// a visually hidden "step n:" instead). The reasons are the strings
// tiered-v1 emits, computed by example-pool.ts; "…" stands for values that
// only a live exchange produces (latency, usage, cost).
import { renameRoute, renameHeaders as h } from '../lib/example-pool';

type Line = { text: string; step?: number; tone?: 'decider' | 'chosen' };

const headers: Line[] = [
  { text: `X-Router-Profile: ${h.profile}`, step: 6 },
  { text: `X-Router-Model: ${h.model}` },
  { text: `X-Router-Tier: ${h.tier}`, step: 3, tone: 'chosen' },
  { text: `X-Router-Decider: ${h.decider}`, step: 2, tone: 'decider' },
  { text: `X-Router-Policy: ${h.policy}` },
  { text: `X-Router-Difficulty: ${h.difficulty}`, step: 2, tone: 'decider' },
  { text: `X-Router-Confidence: ${h.confidence}`, step: 2, tone: 'decider' },
  { text: 'X-Router-Undecidable: 0' },
  { text: 'X-Router-Latency-Ms: …' },
  { text: 'X-Router-Mode: route' }
];

const r = renameRoute;
const q = (s: string) => JSON.stringify(s);
const reasons = r.reasons.map(q);
const candidatesLine = reasons.findIndex((s) => s.startsWith('"candidates:'));
const object: Line[] = [
  { text: '"router": {' },
  {
    text: `  "signals": {"difficulty": ${h.difficulty}, "tags": {"code": 1.0, "math": 0.0, …},`,
    step: 2,
    tone: 'decider'
  },
  { text: `              "confidence": ${h.confidence}},`, step: 2, tone: 'decider' },
  {
    text: `  "chosen": {"profile": ${q(r.chosen.key)}, "model": ${q(r.chosen.id)}, "tier": ${q(r.chosen.tier)},`,
    step: 3,
    tone: 'chosen'
  },
  { text: `             "tier_source": ${q(r.chosen.tierSource)}},`, step: 3, tone: 'chosen' },
  ...reasons.map((s, i) => ({
    text: `${i === 0 ? '  "reasons": [' : '              '}${s}${i === reasons.length - 1 ? '],' : ','}`,
    step: i === candidatesLine ? 4 : undefined,
    tone: i === candidatesLine ? ('chosen' as const) : undefined
  })),
  { text: '  "blocked": [],', step: 1 },
  { text: '  "decision_cost_usd": …, "usage": {…}, "cost_usd": …,', step: 5 },
  { text: `  "provider_reported_model": ${q(r.chosen.id)}, "mismatch": false`, step: 6 },
  { text: '}' }
];

const panels = [
  { label: 'Headers', lines: headers },
  { label: 'router object (trimmed)', lines: object }
];

const css = `
.disc{view-timeline-name:--disc}
.disc pre{position:relative}
.disc .ln{display:block;position:relative;padding-left:2.1rem;white-space:pre;width:max-content;min-width:100%;box-sizing:border-box}
@media (max-width:639.98px){.disc .ln{white-space:pre-wrap;width:auto;overflow-wrap:anywhere}}
.disc .ln[data-step]{background:color-mix(in srgb,var(--color-paper) 9%,transparent)}
.disc .ln[data-tone="decider"]{background:color-mix(in srgb,var(--color-explicit) 22%,transparent)}
.disc .ln[data-tone="chosen"]{background:color-mix(in srgb,var(--color-qualified-on-ink) 20%,transparent)}
.disc .mk{position:absolute;left:.35rem;top:.65rem;transform:translateY(-50%);width:1.15rem;height:1.15rem;border-radius:50%;background:var(--color-paper);color:var(--color-ink);font-size:.66rem;line-height:1.15rem;text-align:center;font-weight:500}
@supports (animation-timeline: view()){
@media (prefers-reduced-motion:no-preference){
@keyframes disc-band{from{background-color:transparent}}
.disc .ln[data-step]{animation-name:disc-band;animation-duration:auto;animation-fill-mode:both;animation-timing-function:ease-out;animation-timeline:--disc}
}}
`;
// The bands sweep in step order, 1 to 6, as the block scrolls in.
const range = (step: number) => `animation-range:entry ${30 + step * 10}% entry ${40 + step * 10}%`;
---

<style set:html={css}></style>

<div class="disc grid gap-6 lg:grid-cols-[minmax(0,2fr)_minmax(0,3fr)]">
  {
    panels.map((p) => (
      <div class="min-w-0">
        <p class="eyebrow mb-2">{p.label}</p>
        <pre tabindex="0" role="region" aria-label={p.label} class="bg-[var(--color-ink)] text-[var(--color-paper)] py-3 pr-4 overflow-x-auto text-[0.8rem] leading-relaxed w-full"><code>{p.lines.map((l) =>
          l.step ? (
            <span class="ln" data-step={l.step} data-tone={l.tone} style={range(l.step)}><span class="mk" aria-hidden="true">{l.step}</span><span class="sr-only">step {l.step}: </span>{l.text}</span>
          ) : (
            <span class="ln">{l.text}</span>
          )
        )}</code></pre>
      </div>
    ))
  }
</div>
