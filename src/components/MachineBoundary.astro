---
// "What leaves your machine": the two destinations a routed request can reach, and
// the browser origin that is refused. Static. The only red on the page
// outside status dots: red means refused.
---

<style>
  .dg.mb text {
    font-size: 13px;
  }
  .dg.mb .sm {
    font-size: 12px;
  }
</style>

<svg class="dg mb max-w-[26rem]" viewBox="0 0 380 244" role="img" aria-labelledby="mb-t mb-d">
  <title id="mb-t">What leaves your machine</title>
  <desc id="mb-d"
    >Inside your machine, your client calls delegation-router on 127.0.0.1. A request reaches at most two
    destinations outside it: the decider, sent an excerpt by default with the decider's own key, and
    the chosen model, sent the request with that model's own key. A browser page whose origin
    is not listed is refused at the boundary.</desc
  >
  <defs>
    <marker id="mb-ai" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 z" fill="var(--color-ink)"></path></marker>
    <marker id="mb-aa" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 z" fill="var(--color-explicit)"></path></marker>
  </defs>
  <rect x="8" y="24" width="184" height="160" class="bnd"></rect>
  <text x="20" y="42" class="sm soft">your machine</text>
  <rect x="20" y="54" width="160" height="30" class="box"></rect>
  <text x="100" y="74" class="mid">your client</text>
  <path d="M100 84 V106" class="path" marker-end="url(#mb-ai)"></path>
  <rect x="20" y="110" width="160" height="48" class="box"></rect>
  <text x="32" y="130">delegation-router</text>
  <text x="32" y="148" class="sm soft">127.0.0.1</text>

  <path d="M180 120 C 204 120, 206 34, 224 34" class="amber" marker-end="url(#mb-aa)"></path>
  <rect x="224" y="20" width="148" height="28" fill="var(--color-explicit-soft)" stroke="var(--color-explicit)" stroke-width="1.5"></rect>
  <text x="298" y="39" class="mid">decider</text>
  <text x="226" y="64" class="sm">excerpt by default</text>
  <text x="226" y="78" class="sm soft">its own key</text>

  <path d="M180 146 C 204 146, 206 124, 224 124" class="path" marker-end="url(#mb-ai)"></path>
  <rect x="224" y="110" width="148" height="28" class="box"></rect>
  <text x="298" y="129" class="mid">the chosen model</text>
  <text x="226" y="154" class="sm">the request</text>
  <text x="226" y="168" class="sm soft">that model’s own key</text>

  <rect x="30" y="208" width="110" height="26" class="chip" stroke="var(--color-ink)"></rect>
  <text x="85" y="225" class="mid sm">browser page</text>
  <path d="M85 208 V190" class="refused"></path>
  <path d="M73 188 H97" class="refused" stroke-width="2.5"></path>
  <text x="150" y="225" class="sm err">origin not listed → refused</text>
</svg>
