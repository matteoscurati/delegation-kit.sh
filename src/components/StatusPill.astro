---
// A gate decision as a solid colour block. The colour is the gate vocabulary:
// green = may be chosen (qualified), amber = needs your explicit hand
// (provisional / manual-qualified, always explicit-only), red = blocked
// (candidate / disabled). Nothing else on the site uses these colours.
interface Props {
  status: string;
  selection?: string;
}
const { status, selection } = Astro.props;
const label =
  selection === 'blocked' && status !== 'candidate' && status !== 'disabled' ? 'blocked' : status;
---

<span class={`status status-${label}`} title={selection ? `selection: ${selection}` : undefined}
  >{label}</span
>
