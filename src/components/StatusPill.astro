---
// Two vocabularies, kept apart on purpose.
// `kind="compat"`: what the adapter can do today — compatible (green, may be
// selected) or unsupported (red outline, cannot). This is what decides.
// `kind="history"`: the historical qualification status of the same row,
// muted, because since 0.24.0 it informs and never gates.
interface Props {
  kind: 'compat' | 'history';
  value: string | boolean | null | undefined;
}
const { kind, value } = Astro.props;
const label =
  kind === 'compat' ? (value ? 'compatible' : 'unsupported') : value ? String(value) : 'no record';
const cls =
  kind === 'compat'
    ? value
      ? 'status status-compatible'
      : 'status status-unsupported'
    : 'status status-history';
---

<span class={cls}>{label}</span>
