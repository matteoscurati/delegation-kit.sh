---
// What the adapter can do today — compatible (green, may be selected) or
// unsupported (red outline, cannot). This is the only thing that decides.
interface Props {
  kind: 'compat';
  value: boolean | null | undefined;
}
const { value } = Astro.props;
const label = value ? 'compatible' : 'unsupported';
const cls = value ? 'status status-compatible' : 'status status-unsupported';
---

<span class={cls}>{label}</span>
