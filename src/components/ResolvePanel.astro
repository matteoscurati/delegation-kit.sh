---
// The lists a `delegation-route resolve` (schema 3) answer contains.
import StatusPill from './StatusPill.astro';

type Row = {
  profile: string;
  model: string;
  family: string | null;
  adapter: string;
  technical_compatibility: boolean;
  capabilities: string[];
  selection: string;
};
interface Props {
  choices: Row[];
  blocked: Row[];
  /** Why rows land in `blocked` for this panel. */
  blockedNote: string;
}
const { choices, blocked, blockedNote } = Astro.props;
---

<div class="grid gap-6 md:grid-cols-[1.6fr_1fr]">
  <div>
    <p class="eyebrow mb-2">choices — you pick one, or authorize the lead to</p>
    {
      choices.length === 0 ? (
        <p class="text-sm text-[var(--color-ink-soft)]">
          none — no profile in the configuration supports this role
        </p>
      ) : (
        <ul class="text-sm divide-y divide-[var(--color-line)]">
          {choices.map((row) => (
            <li class="py-1.5 flex items-baseline justify-between gap-3">
              <span>
                <span class="font-mono font-medium">{row.profile}</span>
                <span class="font-mono text-[var(--color-ink-soft)] text-[0.75rem] block">
                  {row.model} / {row.adapter} · {row.family ?? 'no family'} ·{' '}
                  {row.capabilities.join(', ')}
                </span>
              </span>
            </li>
          ))}
        </ul>
      )
    }
  </div>
  <div>
    <p class="eyebrow mb-2">blocked — {blockedNote}</p>
    {
      blocked.length === 0 ? (
        <p class="text-sm text-[var(--color-ink-soft)]">none</p>
      ) : (
        <ul class="text-sm divide-y divide-[var(--color-line)]">
          {blocked.map((row) => (
            <li class="py-1.5 flex items-baseline justify-between gap-3">
              <span class="font-mono">
                {row.profile}
                <span class="text-[var(--color-ink-soft)] text-[0.75rem]">
                  {' '}
                  · {row.family ?? 'no family'}
                </span>
              </span>
              {row.technical_compatibility ? (
                <span class="status status-excluded">same family</span>
              ) : (
                <StatusPill kind="compat" value={false} />
              )}
            </li>
          ))}
        </ul>
      )
    }
  </div>
</div>
