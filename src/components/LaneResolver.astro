---
// "Resolve a lane": `delegation-route resolve` with no JavaScript.
//
// Every answer shown here was produced by the kit's own router at build time
// against a fresh default preset (scripts/sync-kit.mjs): every lane under the
// default review policy, every review lane once per producer family under the
// strict `cross-family` preset, and each compound lane. Radio buttons pick the
// lane, the policy and the producer; CSS `:has()` reveals the precomputed
// panel. The page cannot disagree with the router, and it ships no script.
import resolve from '../data/resolve.json';
import kit from '../data/kit.json';
import ResolvePanel from './ResolvePanel.astro';

type Row = {
  profile: string;
  model: string;
  family: string | null;
  adapter: string;
  technical_compatibility: boolean;
  capabilities: string[];
  evidence: { status?: string } | Record<string, never>;
  selection: string;
};
type Resolved = { lane: string; choices: Row[]; blocked: Row[]; review_policy: string };
type Compound = {
  lane: string;
  members: string[];
  protocol: string;
  historical_evidence: { status?: string; activation?: string; final_authority?: string };
  requires_explicit_member_dispatches: boolean;
};

const plain = resolve.lanes as unknown as Record<string, Resolved>;
const strict = resolve.strict as unknown as Record<string, Record<string, Resolved>>;
const compound = resolve.compound as unknown as Record<string, Compound>;
const reviewLanes = kit.reviewLanes as string[];
const laneList = Object.keys(plain).sort();
const compoundLanes = Object.keys(compound).sort();
const families = kit.families as string[];
const defaultLane = 'builder';
const defaultFamily = 'openai';

const laneId = (lane: string) => `lane-${lane}`;
const familyId = (family: string) => `producer-${family}`;

const rules: string[] = ['.resolver .panel{display:none}'];
for (const lane of laneList)
  rules.push(
    `.resolver:has(#${laneId(lane)}:checked):has(#policy-optional:checked) .panel[data-lane="${lane}"][data-policy="optional"]{display:block}`
  );
for (const lane of laneList.filter((l) => !reviewLanes.includes(l)))
  rules.push(
    `.resolver:has(#${laneId(lane)}:checked):has(#policy-strict:checked) .panel[data-lane="${lane}"][data-policy="optional"]{display:block}`
  );
for (const lane of reviewLanes)
  for (const family of families)
    rules.push(
      `.resolver:has(#${laneId(lane)}:checked):has(#policy-strict:checked):has(#${familyId(family)}:checked) .panel[data-lane="${lane}"][data-policy="strict"][data-family="${family}"]{display:block}`
    );
for (const lane of compoundLanes)
  rules.push(`.resolver:has(#${laneId(lane)}:checked) .panel[data-lane="${lane}"]{display:block}`);
rules.push('.resolver .producer{display:none}');
rules.push(
  '.resolver:has(input[data-review]:checked):has(#policy-strict:checked) .producer{display:block}'
);
rules.push(
  '.resolver .lane-option{border:1px solid var(--color-line);padding:.35rem .6rem;cursor:pointer;font-family:var(--font-mono);font-size:.8rem;background:var(--color-panel)}',
  '.resolver input:checked + .lane-option{background:var(--color-ink);color:var(--color-paper);border-color:var(--color-ink)}',
  '.resolver input:focus-visible + .lane-option{outline:2px solid var(--color-ink);outline-offset:2px}',
  '.resolver input[type=radio]{position:absolute;opacity:0;width:1px;height:1px;overflow:hidden}'
);
const css = rules.join('\n');

const command = (lane: string, family?: string, strictPolicy = false) =>
  `${strictPolicy ? 'DELEGATION_CONFIG_FILE=strict.json ' : ''}delegation-route resolve --lane ${lane}${family ? ` --producer-family ${family}` : ''} --json`;
---

<style set:html={css}></style>

<div class="resolver relative">
  <div class="grid gap-5 md:grid-cols-[2fr_1fr_1fr] md:items-start">
    <fieldset class="min-w-0">
      <legend class="eyebrow mb-2">Role</legend>
      <div class="flex flex-wrap gap-1.5">
        {
          [...laneList, ...compoundLanes].map((lane) => (
            <span class="relative">
              <input
                type="radio"
                name="lane"
                id={laneId(lane)}
                value={lane}
                checked={lane === defaultLane}
                data-review={reviewLanes.includes(lane) ? '' : undefined}
              />
              <label for={laneId(lane)} class="lane-option inline-block">
                {lane}
              </label>
            </span>
          ))
        }
      </div>
    </fieldset>
    <fieldset class="min-w-0">
      <legend class="eyebrow mb-2">review_policy</legend>
      <div class="flex flex-wrap gap-1.5">
        <span class="relative">
          <input type="radio" name="policy" id="policy-optional" value="optional" checked />
          <label for="policy-optional" class="lane-option inline-block">optional</label>
        </span>
        <span class="relative">
          <input type="radio" name="policy" id="policy-strict" value="cross-family" />
          <label for="policy-strict" class="lane-option inline-block">cross-family</label>
        </span>
      </div>
    </fieldset>
    <fieldset class="producer min-w-0">
      <legend class="eyebrow mb-2">Producer family (excluded)</legend>
      <div class="flex flex-wrap gap-1.5">
        {
          families.map((family) => (
            <span class="relative">
              <input
                type="radio"
                name="producer"
                id={familyId(family)}
                value={family}
                checked={family === defaultFamily}
              />
              <label for={familyId(family)} class="lane-option inline-block">
                {family}
              </label>
            </span>
          ))
        }
      </div>
    </fieldset>
  </div>

  <div class="mt-6">
    {
      laneList.map((lane) => {
        const r = plain[lane];
        return (
          <div class="panel" data-lane={lane} data-policy="optional">
            <p class="font-mono text-[0.8rem] text-[var(--color-ink-soft)] mb-4">
              $ {command(lane)}
            </p>
            <ResolvePanel
              choices={r.choices}
              blocked={r.blocked}
              blockedNote="the adapter does not support this role"
            />
          </div>
        );
      })
    }
    {
      reviewLanes.map((lane) =>
        families.map((family) => {
          const r = strict[lane][family];
          return (
            <div class="panel" data-lane={lane} data-policy="strict" data-family={family}>
              <p class="font-mono text-[0.8rem] text-[var(--color-ink-soft)] mb-4">
                $ {command(lane, family, true)}
              </p>
              <ResolvePanel
                choices={r.choices}
                blocked={r.blocked}
                blockedNote="same family as the producer, or role unsupported"
              />
            </div>
          );
        })
      )
    }
    {
      compoundLanes.map((lane) => {
        const c = compound[lane];
        return (
          <div class="panel" data-lane={lane}>
            <p class="font-mono text-[0.8rem] text-[var(--color-ink-soft)] mb-4">
              $ {command(lane)}
            </p>
            <div class="grid gap-6 md:grid-cols-[1fr_1fr]">
              <div>
                <p class="eyebrow mb-2">Compound lane — each member is its own dispatch</p>
                <p class="font-mono text-sm">{c.members.join(' + ')}</p>
                <p class="text-sm text-[var(--color-ink-soft)] mt-2">
                  Protocol <span class="font-mono">{c.protocol}</span>; final authority:{' '}
                  {c.historical_evidence.final_authority ?? 'lead'}. Selecting the compound lane
                  grants nothing; each member needs its own explicit dispatch.
                </p>
              </div>
              <div>
                <p class="eyebrow mb-2">Historical activation note</p>
                <p class="text-sm">{c.historical_evidence.activation}</p>
              </div>
            </div>
          </div>
        );
      })
    }
    <p
      class="font-mono text-[0.75rem] text-[var(--color-ink-soft)] mt-6 border-t border-[var(--color-line)] pt-3"
    >
      schema_version: 2 · requires_user_direction: true · automatic_dispatch: false ·
      authorization_granted: false
    </p>
  </div>
</div>
