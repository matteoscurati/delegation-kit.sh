---
// Hand dispatch: the same profiles, sent a task directly from Claude Code or
// Codex. The resolver and the routing table moved here from the home page,
// unchanged; the home page keeps one paragraph and a link.
import BaseLayout from '../layouts/BaseLayout.astro';
import LaneResolver from '../components/LaneResolver.astro';
import RoutingTable from '../components/RoutingTable.astro';
import kit from '../data/kit.json';
---

<BaseLayout
  title="Dispatch by hand — delegation-kit"
  description="Without the router: the same profiles, sent a task directly from Claude Code or Codex. delegation-route resolve lists the profiles that can take a role; delegation-run dispatches the one you name and writes a receipt."
  path="/dispatch"
>
  <section class="pt-10 pb-14">
    <p class="eyebrow mb-6">Without the router</p>
    <h1 class="text-[2.2rem] md:text-[3.4rem] max-w-4xl">Profiles, roles and the resolver</h1>
    <p class="mt-6 max-w-2xl text-[var(--color-ink-soft)]">
      The same profiles the router chooses from can be sent a task directly from Claude Code or Codex.
      <span class="font-mono text-[var(--color-ink)]">delegation-route resolve</span> lists the profiles
      that can take a role, such as builder or reviewer, and validates a choice without dispatching.
      <span class="font-mono text-[var(--color-ink)]">delegation-run</span> dispatches the one you name,
      inside its runner's sandbox, and writes a receipt. Hand dispatch never starts on its own: a retry
      or a review is a new dispatch that you ask for. The router is not involved here; it only routes
      what you send it after you start <span class="font-mono text-[var(--color-ink)]">serve</span>.
    </p>
  </section>

  <section class="rule py-14">
    <div class="md:flex md:items-baseline md:justify-between md:gap-10 mb-8">
      <h2 class="text-3xl md:text-4xl">Resolve a role</h2>
      <p class="text-sm text-[var(--color-ink-soft)] max-w-md mt-3 md:mt-0">
        Pick a role and a review policy to see which profiles resolve, and which are excluded because
        they share the producer's family. Computed by the kit when the site was built from
        {kit.version}; no script runs here.
      </p>
    </div>
    <LaneResolver />
  </section>

  <section class="rule py-14">
    <div class="md:flex md:items-baseline md:justify-between md:gap-10 mb-6">
      <h2 class="text-3xl md:text-4xl">The default preset, by role</h2>
      <p class="text-sm text-[var(--color-ink-soft)] max-w-xl mt-3 md:mt-0">
        {kit.profiles} profiles and {kit.laneRows} role rows from the default preset, straight from
        <span class="font-mono">delegation-route table</span>. For hand dispatch, the adapter decides
        which roles a profile can take. The router does not read roles: it chooses only among the pool
        you declare, by rung and price.
      </p>
    </div>
    <p class="flex flex-wrap gap-x-5 gap-y-2 text-[0.75rem] mb-4">
      <span><span class="status status-compatible">compatible</span> the adapter supports this role</span>
      <span><span class="status status-unsupported">unsupported</span> it does not; never selectable</span>
    </p>
    <RoutingTable />
  </section>

  <section class="rule py-14">
    <p class="max-w-2xl text-[var(--color-ink-soft)]">
      Six provider runners enforce each CLI's sandbox, identity check and limits, and
      <span class="font-mono text-[var(--color-ink)]">delegation-patch-verify</span> checks a text
      model's patch before you apply it. The
      <a href="/docs/executors" class="underline underline-offset-4 text-[var(--color-ink)]">executors page</a>
      has every adapter and permission class;
      <a href="/docs/configuration" class="underline underline-offset-4 text-[var(--color-ink)]">personal configuration</a>
      covers profiles, roles and review policies.
    </p>
  </section>
</BaseLayout>
