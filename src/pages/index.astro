---
import BaseLayout from '../layouts/BaseLayout.astro';
import CodeBlock from '../components/CodeBlock.astro';
import HeroResponse from '../components/HeroResponse.astro';
import LadderStepper from '../components/LadderStepper.astro';
import LadderChart from '../components/LadderChart.astro';
import { glm, opus, priceTag, catalogVersion } from '../lib/example-pool';

const promises = [
  'Runs on your machine, picks only from your models, sends each request once: no retry.',
  'By default your decider sees an excerpt; only the chosen model sees the full request.',
  'No request log; the optional decision log never stores prompts.'
];

const link = 'underline underline-offset-4 text-[var(--color-ink)]';
const step = 'border-t border-[var(--color-line)] pt-4';
const stepNum = 'font-mono text-[var(--color-ink-soft)] text-sm';
const stepTitle = 'text-xl mt-2 mb-2 leading-tight';
---

<BaseLayout path="/">
  <!-- Hero -->
  <section class="pt-10 pb-14 md:pt-16 md:pb-20">
    <p class="eyebrow mb-6">A model router on your own machine</p>
    <h1 class="text-[2.6rem] md:text-[3.4rem] xl:text-[3.9rem] [text-wrap:balance]">
      <span class="lg:block">Easy requests go to your cheap models.</span>
      <span class="lg:block">Hard ones go to your strong ones.</span>
    </h1>
    <div class="mt-10 grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,26rem)] lg:items-start">
      <div class="min-w-0">
        <p class="max-w-xl text-lg md:text-xl text-[var(--color-ink-soft)]">
          A decider you pick, usually one of your cheap models, rates how hard each request is. The
          cheapest of your models strong enough for it answers, and the response says which one, and why.
        </p>
        <div class="mt-8 max-w-md">
          <CodeBlock
            label="The only change in your client"
            code={`base_url = "http://127.0.0.1:4141/v1"
model    = "auto"`}
          />
          <p class="mt-2 text-sm text-[var(--color-ink-soft)]">
            Works with any OpenAI chat client.
          </p>
        </div>
        <p class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
          <a href="/docs/" class="btn px-4 py-2">Get started →</a>
          <a href="#how" class={link}>How it picks ↓</a>
        </p>
      </div>
      <HeroResponse />
    </div>
  </section>

  <!-- How it picks a model -->
  <section id="how" class="rule py-14 scroll-mt-4">
    <h2 class="text-3xl md:text-4xl mb-10">How it picks a model</h2>
    <ol role="list" class="grid gap-x-8 gap-y-8 md:grid-cols-3">
      <li class={step}>
        <span class={stepNum} aria-hidden="true">1</span>
        <h3 class={stepTitle}>Every model gets a tier</h3>
        <p class="text-[var(--color-ink-soft)]">
          Artificial Analysis, an independent lab, gives every model the same tests and a score. Within 8
          points of the day's best score: frontier, the strongest tier. Within 20: mid. The rest: small.
        </p>
      </li>
      <li class={step}>
        <span class={stepNum} aria-hidden="true">2</span>
        <h3 class={stepTitle}>Your decider rates the request</h3>
        <p
          class="inline-block mb-3 bg-white border border-[var(--color-line)] border-l-4 border-l-[var(--color-explicit)] px-3 py-1 font-mono text-sm"
        >
          1 of 4 · code
        </p>
        <p class="text-[var(--color-ink-soft)]">
          It reads an excerpt, never your keys or your list of models, and answers: how hard is this, 0
          to 4? Code, math, rare knowledge?
        </p>
      </li>
      <li class={step}>
        <span class={stepNum} aria-hidden="true">3</span>
        <h3 class={stepTitle}>The cheapest model on that tier answers</h3>
        <p class="text-[var(--color-ink-soft)]">
          0–1 needs small, 2 mid, 3–4 frontier; math or rare knowledge, mid at least. None of yours on
          that tier? The next one up. Code: the cheapest model good at code, on that tier or above. No
          rating? Your default model answers.
        </p>
      </li>
    </ol>

    <div class="mt-14">
      <p class="eyebrow mb-4">Scores on {catalogVersion}</p>
      <LadderChart />
      <p class="mt-4 max-w-2xl text-[var(--color-ink-soft)]">
        Ringed: the models in the examples. Refresh the scores with your own Artificial Analysis key, or
        set any model's tier yourself.
      </p>
    </div>
  </section>

  <!-- Which model answers? -->
  <section class="rule py-14">
    <h2 class="text-3xl md:text-4xl mb-3">Which model answers?</h2>
    <p class="text-[var(--color-ink-soft)] max-w-xl mb-10">
      Your two models: glm ({glm.name}, {glm.tier}, ~{priceTag(glm)} a request) and opus ({opus.name},
      {opus.tier}, ~{priceTag(opus)}).
    </p>
    <LadderStepper />
  </section>

  <!-- What it promises · What it costs -->
  <section class="rule py-14">
    <div class="grid gap-12 md:grid-cols-2">
      <div>
        <h2 class="text-2xl mb-5">What it promises</h2>
        <ul class="border-b border-[var(--color-line)]">
          {promises.map((t) => <li class="border-t border-[var(--color-line)] py-2.5">{t}</li>)}
        </ul>
      </div>
      <div>
        <h2 class="text-2xl mb-5">What it costs</h2>
        <p class="border-t border-[var(--color-line)] pt-2.5">
          Free (MIT). At most one decider call per request.
        </p>
      </div>
    </div>
  </section>

  <!-- Set it up -->
  <section id="install" class="rule py-14 scroll-mt-4">
    <h2 class="text-3xl md:text-4xl mb-8">Set it up</h2>
    <div class="grid gap-8 lg:grid-cols-2">
      <CodeBlock
        label="1 · Install, then list your models"
        code={`# macOS, with Node.js, jq, git and python3
npx delegation-kit
delegation-config show`}
      />
      <div class="min-w-0">
        <CodeBlock
          lang="json"
          label="2 · Add to ~/.config/delegation-kit/config.json"
          code={`"router": {
  "decider": {
    "kind": "llm",
    "profile": "deepseek-flash"
  },
  "pool": [
    "deepseek-flash",
    "opus-reviewer"
  ],
  "default": "deepseek-flash"
}`}
        />
        <p class="mt-2 text-sm text-[var(--color-ink-soft)]">
          Your models can be API keys, local endpoints or Claude, Codex, GLM, Kimi, Grok plans. Both ship with the install.
        </p>
      </div>
      <div class="min-w-0 lg:col-span-2">
        <CodeBlock
          label="3 · Start it; send a request from another terminal"
          code={`delegation-router serve
curl -si 127.0.0.1:4141/v1/chat/completions \\
  -H 'Content-Type: application/json' \\
  -d '{"model":"auto","messages":[{"role":"user","content":"Rename foo to bar in utils.py"}]}'`}
        />
      </div>
    </div>
    <p class="mt-8 flex flex-wrap gap-x-6 gap-y-2">
      <a href="/docs/" class={link}>Get started →</a>
      <a href="/docs/router/" class={link}>Router reference →</a>
    </p>
  </section>
</BaseLayout>

<style>
  /* An ink button: paper text on ink. */
  .btn {
    background: var(--color-ink);
    color: var(--color-paper);
  }
</style>
