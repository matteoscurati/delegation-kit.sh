---
import BaseLayout from '../layouts/BaseLayout.astro';
import CodeBlock from '../components/CodeBlock.astro';
import HeroResponse from '../components/HeroResponse.astro';
import RequestFlow from '../components/RequestFlow.astro';
import LadderStepper from '../components/LadderStepper.astro';
import LadderChart from '../components/LadderChart.astro';
import kit from '../data/kit.json';
import { glm, opus } from '../lib/example-pool';

// The text equivalent of the flow diagram, which is aria-hidden.
const steps = [
  ['Measure', 'tokens, tools, images, JSON — counted, not judged'],
  ['Ask the decider', 'how hard is this, 0–4? code, math, rare?'],
  ['Find the rung', 'the answer sets the lowest rung: small, mid, frontier'],
  ['Take the cheapest', 'the cheapest model of yours on that rung'],
  ['Forward once', 'with that model’s own key; no retry'],
  ['Disclose', 'headers and reasons in every response']
];

const deciders = [
  ['llm', 'one of your own cheap models'],
  ['sage', 'Levanto Sage, with your key'],
  ['jev', 'TypeSafe Jev, with your key'],
  ['dipylon', 'your own decision service'],
  ['classifier', 'any local classifier'],
  ['none', 'always your default — the baseline']
];

const promises = [
  'Runs on your machine, loopback only.',
  'Chooses only from the models you list.',
  'One forward per request. No retry, no fallback.',
  'Never sends your keys or model names to the decider.',
  'Logs nothing. Receipts only if you turn them on.',
  'A cost ceiling refuses rather than overspends.'
];

const link = 'underline underline-offset-4 text-[var(--color-ink)]';
const mono = 'font-mono text-[0.9em]';
---

<BaseLayout path="/">
  <!-- Hero -->
  <section class="pt-10 pb-14 md:pt-16 md:pb-20">
    <p class="eyebrow mb-6">delegation-kit · v{kit.version} · a model router on your machine</p>
    <h1 class="text-[2.6rem] md:text-[3.4rem] xl:text-[3.9rem] [text-wrap:balance]">
      <span class="lg:block">Easy requests go to your cheap models.</span>
      <span class="lg:block">Hard ones go to your strong ones.</span>
    </h1>
    <div class="mt-10 grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,26rem)] lg:items-start">
      <div class="min-w-0">
        <p class="max-w-xl text-lg md:text-xl text-[var(--color-ink-soft)]">
          You pick a decision model. It rates how hard each request is. Your rules turn that into the
          cheapest model that can handle it — and every response says which one, and why.
        </p>
        <div class="mt-8 max-w-md">
          <CodeBlock
            label="The only change in your client"
            code={`base_url = "http://127.0.0.1:4141/v1"
model    = "auto"`}
          />
        </div>
        <p class="mt-6 flex flex-wrap gap-x-6 gap-y-2">
          <a href="#how" class={link}>How it works ↓</a>
          <a href="#install" class={link}>Install ↓</a>
        </p>
      </div>
      <HeroResponse />
    </div>
  </section>

  <!-- How a request is routed -->
  <section id="how" class="rule py-14 scroll-mt-4">
    <h2 class="text-3xl md:text-4xl mb-3">One request, six steps</h2>
    <p class="text-[var(--color-ink-soft)] max-w-xl mb-10">
      Only one step is a model's judgement — and it judges the task, never your models.
    </p>
    <RequestFlow />
    <ol role="list" class="mt-10 grid gap-x-8 gap-y-4 sm:grid-cols-2 lg:grid-cols-3 text-sm">
      {
        steps.map(([name, text], i) => (
          <li class="flex gap-3 border-t border-[var(--color-line)] pt-3">
            <span class="font-mono text-[var(--color-ink-soft)]" aria-hidden="true">{i + 1}</span>
            <span>
              <span class="font-medium">{name}</span>
              <span class="text-[var(--color-ink-soft)]"> — {text}</span>
            </span>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- Why this model -->
  <section class="rule py-14">
    <h2 class="text-3xl md:text-4xl mb-3">Why this model and not that one</h2>
    <p class="text-[var(--color-ink-soft)] max-w-xl mb-10">
      glm is cheap ({glm.tier}), opus is strong ({opus.tier}). Pick a request.
    </p>
    <LadderStepper />
  </section>

  <!-- Where the rungs come from -->
  <section class="rule py-14">
    <h2 class="text-3xl md:text-4xl mb-3">Who decides which model is strong?</h2>
    <p class="text-[var(--color-ink-soft)] max-w-xl mb-10">
      Not the decider, and not us. Artificial Analysis, an independent lab, gives every model the same
      public tests and a score. The best score of the day sets the bar: up to 8 points below it is
      frontier, up to 20 is mid, the rest is small. The kit ships today's scores. Refresh them with
      your own key, or place any model yourself.
    </p>
    <LadderChart />
  </section>

  <!-- Deciders + promises -->
  <section class="rule py-14">
    <div class="grid gap-12 md:grid-cols-2">
      <div>
        <h2 class="text-3xl md:text-4xl mb-6">Pick the decider</h2>
        <dl class="border-b border-[var(--color-line)]">
          {
            deciders.map(([kind, text]) => (
              <div class="border-t border-[var(--color-line)] py-2.5 grid grid-cols-[7rem_minmax(0,1fr)] gap-4">
                <dt class="font-mono font-medium pl-3 border-l-2 border-[var(--color-explicit)]">{kind}</dt>
                <dd class="text-[var(--color-ink-soft)]">{text}</dd>
              </div>
            ))
          }
        </dl>
        <p class="mt-4 text-sm text-[var(--color-ink-soft)]">
          <span class={mono}>delegation-router eval</span> tells you which one is right on your own prompts.
        </p>
      </div>
      <div>
        <h2 class="text-3xl md:text-4xl mb-6">What it won't do</h2>
        <ul class="border-b border-[var(--color-line)]">
          {promises.map((t) => <li class="border-t border-[var(--color-line)] py-2.5">{t}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- Set it up -->
  <section id="install" class="rule py-14 scroll-mt-4">
    <h2 class="text-3xl md:text-4xl mb-8">Set it up</h2>
    <div class="grid gap-8 lg:grid-cols-2">
      <CodeBlock
        label="1 · Install"
        code={`npx delegation-kit         # macOS · jq · git · python3
delegation-config show     # your models, one profile each`}
      />
      <CodeBlock
        lang="json"
        label="2 · Name the decider and its pool (config.json)"
        code={`"router": {
  "decider": {"kind": "llm", "profile": "glm"},
  "pool": ["glm", "opus"],
  "default": "glm"
}`}
      />
      <CodeBlock
        label="3 · Serve"
        code={`delegation-router check     # no network: decider, pool, rungs
delegation-router serve     # http://127.0.0.1:4141/v1`}
      />
      <CodeBlock
        label="4 · Send"
        code={`curl -s 127.0.0.1:4141/v1/chat/completions \\
  -d '{"model":"auto","messages":[{"role":"user","content":"Rename foo"}]}'`}
      />
    </div>
  </section>

  <!-- Read further -->
  <section class="rule py-14">
    <div class="grid gap-8 md:grid-cols-4 text-[var(--color-ink-soft)]">
      <p><a href="/docs/router" class={link}>Router reference →</a><br />every field, decider, error</p>
      <p><a href="/docs/configuration" class={link}>Configuration →</a><br />models, keys, adapters</p>
      <p><a href="/docs/compatibility" class={link}>Compatibility →</a><br />real decider answers, costs</p>
      <p><a href="/dispatch" class={link}>Dispatch by hand →</a><br />from Claude Code or Codex</p>
    </div>
  </section>
</BaseLayout>
