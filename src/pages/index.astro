---
import BaseLayout from '../layouts/BaseLayout.astro';
import CodeBlock from '../components/CodeBlock.astro';
import LaneResolver from '../components/LaneResolver.astro';
import RoutingTable from '../components/RoutingTable.astro';
import kit from '../data/kit.json';

const steps = [
  {
    name: 'Configure',
    cmd: 'delegation-config show',
    text: 'Your profiles live in ~/.config/delegation-kit/config.json: an adapter, the model id your endpoint accepts, a declared family, roles, parameters. Any OpenAI-compatible text endpoint works. No kit qualification is required.'
  },
  {
    name: 'Resolve',
    cmd: 'delegation-route resolve --lane builder --json',
    text: 'Read-only. The router lists which of your profiles support the role, what each adapter can do, and the historical record beside it. Nothing is dispatched; selection grants nothing.'
  },
  {
    name: 'Choose',
    cmd: '"Use terra-builder for <task>."',
    text: 'You name the profile, or you authorize the lead to pick from the displayed choices. Task complexity, an installed skill, or a previous authorization is not authorization.'
  },
  {
    name: 'Run',
    cmd: 'delegation-run --profile terra-builder --lane builder --prompt-file task.txt --output out.txt --workdir .',
    text: 'One dispatch, one receipt. Output, metrics, and a .result.json with review status and model identity. Retries and reviews are dispatches too: each needs its own approval.'
  }
];

const failures = [
  {
    mode: 'Agents that dispatch other agents on their own authority',
    answer:
      'Every dispatch is user-directed, per request. The router only lists and validates; delegation-run runs exactly one selected profile once, and its receipt records authorization_granted: false for everything it did not do.'
  },
  {
    mode: 'Silent substitution — you asked for one model and got another',
    answer:
      'Requested and provider-reported identity are kept apart in every receipt. A mismatch fails unless you configured that alias; a missing report is labelled requested-only, never dressed up as certification.'
  },
  {
    mode: 'Unverified output — delegated diffs shipped unread',
    answer:
      'Review is a policy you choose: optional, required, or cross-family. A mandatory policy holds the result as pending-review; it never spawns the reviewer for you. Text adapters return a patch; the lead applies and tests.'
  }
];
---

<BaseLayout path="/">
  <section class="pt-10 pb-14 md:pt-16 md:pb-20">
    <p class="eyebrow mb-6">delegation-kit · v{kit.version} · Claude Code and Codex</p>
    <h1 class="text-[2.6rem] md:text-[4.4rem] max-w-5xl">
      Your models. Your call. The kit never dispatches on its own.
    </h1>
    <p class="mt-8 max-w-2xl text-lg text-[var(--color-ink-soft)]">
      delegation-kit gives Claude Code and Codex a governed way to hand bounded coding work to other
      models: the profiles you configure, through native adapters or any OpenAI-compatible text
      endpoint, dispatched one at a time only when you say so, with a receipt that says what was
      asked, what answered, and whether review is still pending.
    </p>
    <div class="mt-10 grid gap-3 md:grid-cols-[minmax(0,1fr)_auto] md:items-end min-w-0">
      <CodeBlock
        label="Install (macOS, jq, git, Node ≥ 18)"
        code={`npx delegation-kit          # interactive installer; --claude-only / --codex-only
delegation-config show      # the personal configuration it initialized
./doctor.sh                 # from a clone: verify everything is wired`}
      />
      <div class="text-sm text-[var(--color-ink-soft)] md:pb-3">
        or <span class="font-mono text-[var(--color-ink)]">git clone</span> and
        <span class="font-mono text-[var(--color-ink)]">./install.sh</span><br />
        or <span class="font-mono text-[var(--color-ink)]">/plugin install delegation-kit</span>
      </div>
    </div>
  </section>

  <section class="rule py-14">
    <div class="md:flex md:items-baseline md:justify-between md:gap-10 mb-8">
      <h2 class="text-3xl md:text-4xl">Resolve a role</h2>
      <p class="text-sm text-[var(--color-ink-soft)] max-w-md mt-3 md:mt-0">
        The router's real answer for a fresh default configuration, computed by
        <span class="font-mono">delegation-route</span> when the site was built from {kit.version}.
        Switch the review policy to see what cross-family excludes. No script runs on this page.
      </p>
    </div>
    <LaneResolver />
  </section>

  <section class="rule py-14">
    <h2 class="text-3xl md:text-4xl mb-3">How a dispatch happens</h2>
    <p class="text-[var(--color-ink-soft)] max-w-2xl mb-10">
      The flow is always the same four steps, in this order. The first three never call a model.
    </p>
    <ol class="grid gap-8 md:grid-cols-2 lg:grid-cols-4">
      {
        steps.map((step, i) => (
          <li class="border-t border-[var(--color-line-strong)] pt-4">
            <p class="eyebrow mb-1">step {i + 1}</p>
            <h3 class="text-xl mb-3">{step.name}</h3>
            <p class="font-mono text-[0.75rem] bg-[var(--color-panel)] border border-[var(--color-line)] p-2 mb-3 break-words">
              {step.cmd}
            </p>
            <p class="text-sm text-[var(--color-ink-soft)]">{step.text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="rule py-14">
    <h2 class="text-3xl md:text-4xl mb-10">Three failure modes, three answers</h2>
    <div class="grid gap-8 md:grid-cols-3">
      {
        failures.map((f) => (
          <div>
            <p class="text-lg leading-snug mb-3">{f.mode}</p>
            <p class="text-sm text-[var(--color-ink-soft)] border-l-2 border-[var(--color-explicit)] pl-4">
              {f.answer}
            </p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="rule py-14">
    <div class="md:flex md:items-baseline md:justify-between md:gap-10 mb-6">
      <h2 class="text-3xl md:text-4xl">The routing table</h2>
      <p class="text-sm text-[var(--color-ink-soft)] max-w-xl mt-3 md:mt-0">
        {kit.profiles} profiles and {kit.laneRows} role rows from the default preset, straight from
        <span class="font-mono">delegation-route table</span>. The adapter decides what a profile
        can do today. There is no other gate.
      </p>
    </div>
    <p class="flex flex-wrap gap-x-5 gap-y-2 text-[0.75rem] mb-4">
      <span
        ><span class="status status-compatible">compatible</span> the adapter supports this role</span
      >
      <span
        ><span class="status status-unsupported">unsupported</span> it does not; never selectable</span
      >
    </p>
    <RoutingTable />
  </section>

  <section class="rule py-14">
    <h2 class="text-3xl md:text-4xl mb-10">What's in the box</h2>
    <div class="grid gap-10 md:grid-cols-3 text-sm">
      <div>
        <p class="eyebrow mb-3">Configuration · ~/.config/delegation-kit</p>
        <ul class="space-y-2">
          <li>
            <span class="font-mono">delegation-config</span> init / validate / show / apply; the shipped
            presets from <span class="font-mono">config/presets.json</span>, a strict preset for
            cross-family review
          </li>
          <li>
            adapters: <span class="font-mono">{kit.adapters.join(', ')}</span> plus <span
              class="font-mono">openai-compatible</span
            > for any text endpoint
          </li>
          <li>credentials by variable name only; migration backs up a legacy install first</li>
        </ul>
      </div>
      <div>
        <p class="eyebrow mb-3">Hosts · ~/.claude and ~/.codex</p>
        <ul class="space-y-2">
          <li>
            6 Claude subagent profiles and 5 Codex profiles, managed but never overwritten once you
            edit them
          </li>
          <li>the routing and orchestrate skills, loaded only on an explicit delegation request</li>
          <li>the user-direction guard, always loaded from CLAUDE.md and AGENTS.md</li>
        </ul>
      </div>
      <div>
        <p class="eyebrow mb-3">CLI · ~/.local/bin, shared</p>
        <ul class="space-y-2">
          <li>
            <span class="font-mono">delegation-route</span>: the read-only router. Never dispatches.
          </li>
          <li>
            <span class="font-mono">delegation-run</span>: one selected profile, once, with a v2
            receipt
          </li>
          <li>
            <span class="font-mono">delegation-{'{glm,gemini,kimi,grok,qwen,deepseek}'}</span>: the
            six provider runners with their own sandboxes; <span class="font-mono"
              >delegation-patch-verify</span
            > for text patches
          </li>
        </ul>
      </div>
    </div>
  </section>

  <section class="rule py-14">
    <div class="grid gap-10 md:grid-cols-[1fr_1fr]">
      <div>
        <h2 class="text-3xl md:text-4xl mb-3">Configure it</h2>
        <p class="text-[var(--color-ink-soft)]">
          Profiles, adapters, parameters, review policies, aliases for reported identities, and how
          a legacy install migrates.
          <a href="/docs/configuration" class="underline underline-offset-4 text-[var(--color-ink)]"
            >Personal configuration →</a
          >
        </p>
      </div>
      <div>
        <h2 class="text-3xl md:text-4xl mb-3">Read the policy</h2>
        <p class="text-[var(--color-ink-soft)]">
          How one person routes coding work across models, and how the presets were chosen.
          Advisory: it governs nothing, and is still worth reading before you choose.
          <a href="/docs/routing" class="underline underline-offset-4 text-[var(--color-ink)]"
            >Routing policy →</a
          >
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
