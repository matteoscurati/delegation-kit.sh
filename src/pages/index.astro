---
import BaseLayout from '../layouts/BaseLayout.astro';
import CodeBlock from '../components/CodeBlock.astro';
import ExampleTable from '../components/ExampleTable.astro';
import LadderChart from '../components/LadderChart.astro';
import { luna, flash, opus, pool, fallback, catalogVersion, cuts } from '../lib/example-pool';

const promises = [
  'Runs on your machine, picks only from your models, sends each request once: no retry.',
  'By default your decider sees an excerpt; only the chosen model sees the full request.',
  'No request log; the optional decision log never stores prompts.'
];

const models = `${luna.name} (${luna.via}), ${flash.name} (${flash.via}) and ${opus.name} (${opus.via})`;

const config = `"router": {
  "decider": { "kind": "llm", "profile": "${flash.id}" },
  "pool": [${pool.map((p) => `"${p.id}"`).join(', ')}],
  "default": "${fallback.id}"
}`;

const app = `from openai import OpenAI

client = OpenAI(base_url="http://127.0.0.1:4141/v1", api_key="unused")
reply = client.chat.completions.create(
    model="auto",
    messages=[{"role": "user", "content": "Rename foo to bar in utils.py"}],
)`;

const link = 'underline underline-offset-4 text-[var(--color-ink)]';
const step = 'border-t border-[var(--color-line)] pt-4';
const stepNum = 'font-mono text-[var(--color-ink-soft)] text-sm';
const stepTitle = 'text-xl mt-2 mb-2 leading-tight';
const useRow = 'border-t border-[var(--color-line)] pt-5 grid gap-5 lg:grid-cols-[minmax(0,20rem)_minmax(0,1fr)] lg:gap-10';
---

<BaseLayout path="/">
  <!-- Hero -->
  <section class="pt-10 pb-14 md:pt-16 md:pb-16">
    <p class="eyebrow mb-6">A model router on your own machine</p>
    <h1 class="text-[2.6rem] md:text-[3.4rem] xl:text-[3.9rem] [text-wrap:balance]">
      <span class="lg:block">Easy requests go to your cheap models.</span>
      <span class="lg:block">Hard ones go to your strong ones.</span>
    </h1>
    <p class="mt-8 max-w-2xl text-lg md:text-xl text-[var(--color-ink-soft)]">
      Your app sends its requests to delegation-kit instead of to one provider. A decider you pick rates
      how hard each request is, and the cheapest of your models that can handle it answers. Every answer
      says which model wrote it, and why.
    </p>
    <p class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
      <a href="/docs/" class="btn px-4 py-2">Get started →</a>
      <a href="#use" class={link}>How you use it ↓</a>
    </p>
    <div class="mt-12">
      <ExampleTable
        count={3}
        rotate
        caption={`Sent with "model": "auto", shown with four sets of three models from different vendors: in each, the cheapest model whose score reaches the request's minimum answers. The setup below uses the first: ${models}.`}
      />
    </div>
  </section>

  <!-- How you use it -->
  <section id="use" class="rule py-14 scroll-mt-4">
    <h2 class="text-3xl md:text-4xl mb-3">How you use it</h2>
    <p class="text-[var(--color-ink-soft)] max-w-xl mb-10">
      Three steps. In your app, only the address and the model name change.
    </p>
    <ol role="list" class="grid gap-10">
      <li class={useRow}>
        <div>
          <span class={stepNum} aria-hidden="true">1</span>
          <h3 class={stepTitle}>Install it</h3>
          <p class="text-[var(--color-ink-soft)]">
            On macOS, with Node.js, jq, git and python3. It sets up the models it knows (Claude and GPT
            through Claude Code and Codex, DeepSeek, Qwen, GLM, Kimi, Grok) and asks for the API keys you
            have. <a href="/docs/configuration/#adding-a-model" class={link}>Any other model</a> with an
            OpenAI-compatible API can be added, a local one too.
          </p>
        </div>
        <CodeBlock
          label="Terminal"
          code={`npx delegation-kit
delegation-config show  # your models`}
        />
      </li>
      <li class={useRow}>
        <div>
          <span class={stepNum} aria-hidden="true">2</span>
          <h3 class={stepTitle}>Choose your models and the decider</h3>
          <p class="text-[var(--color-ink-soft)]">
            Name the models the router may pick from, the decider that rates each request, and the model
            that answers when the decider can't. Here: {luna.name}, {flash.name} and {opus.name}.
          </p>
        </div>
        <CodeBlock lang="json" label="~/.config/delegation-kit/config.json, next to “profiles”" code={config} />
      </li>
      <li class={useRow}>
        <div>
          <span class={stepNum} aria-hidden="true">3</span>
          <h3 class={stepTitle}>Start it and point your app at it</h3>
          <p class="text-[var(--color-ink-soft)]">
            Anything that uses OpenAI's Chat Completions API works: set the base URL to the router and the
            model to <code class="font-mono text-[0.9em]">"auto"</code>. The answer comes back as usual; its
            <code class="font-mono text-[0.9em]">X-Router-Model</code> header names the model. Claude Code
            and Codex speak other formats: they can't send their requests here, but the router can pick
            them to answer.
          </p>
        </div>
        <div class="grid gap-4 min-w-0">
          <CodeBlock label="Terminal" code="delegation-router serve" />
          <CodeBlock lang="python" label="Your app (Python, OpenAI SDK)" code={app} />
        </div>
      </li>
    </ol>
    <p class="mt-10">
      <a href="/docs/" class="btn px-4 py-2">Get started, step by step →</a>
    </p>
  </section>

  <!-- How it picks a model -->
  <section id="how" class="rule py-14 scroll-mt-4">
    <h2 class="text-3xl md:text-4xl mb-10">How it picks a model</h2>
    <ol role="list" class="grid gap-x-8 gap-y-8 md:grid-cols-3">
      <li class={step}>
        <span class={stepNum} aria-hidden="true">1</span>
        <h3 class={stepTitle}>Every model gets a score</h3>
        <p class="text-[var(--color-ink-soft)]">
          Artificial Analysis, an independent lab, gives every model the same tests and a score. Within 8
          points of the day's best: frontier. Within 20: mid. The rest: small.
        </p>
      </li>
      <li class={step}>
        <span class={stepNum} aria-hidden="true">2</span>
        <h3 class={stepTitle}>Your decider rates the request</h3>
        <p class="text-[var(--color-ink-soft)]">
          It reads an excerpt, never your keys or your list of models, and answers: how hard is this, 0
          to 4, half points allowed? Code, math, rare knowledge?
        </p>
      </li>
      <li class={step}>
        <span class={stepNum} aria-hidden="true">3</span>
        <h3 class={stepTitle}>The cheapest one strong enough answers</h3>
        <p class="text-[var(--color-ink-soft)]">
          The rating sets a minimum score: none for 0–1, {cuts.mid} for 2, {cuts.frontier} for 3–4,
          in between for half points. Math or rare knowledge: {cuts.mid} at least. The cheapest of your
          models above it answers; none above? Your strongest. No rating? Your default.
        </p>
      </li>
    </ol>

    <div class="mt-14">
      <p class="eyebrow mb-4">Scores on {catalogVersion}</p>
      <LadderChart />
      <p class="mt-4 max-w-2xl text-[var(--color-ink-soft)]">
        Ringed: the three models in the examples. Refresh the scores with your own Artificial Analysis
        key, or set any model's tier yourself.
      </p>
    </div>

    <div class="mt-14">
      <h3 class="text-2xl mb-6">With your three models</h3>
      <ExampleTable
        why
        caption="Costs are the router's estimates at API prices, used to compare models; a model you reach through a subscription is billed by your plan."
      />
    </div>
  </section>

  <!-- What it promises · What it costs -->
  <section class="rule py-14">
    <div class="grid gap-12 md:grid-cols-2">
      <div>
        <h2 class="text-2xl mb-5">What it promises</h2>
        <ul class="border-b border-[var(--color-line)]">
          {promises.map((t) => <li class="border-t border-[var(--color-line)] py-2.5">{t}</li>)}
        </ul>
      </div>
      <div>
        <h2 class="text-2xl mb-5">What it costs</h2>
        <p class="border-t border-[var(--color-line)] pt-2.5">
          Free (MIT). At most one decider call per request.
        </p>
      </div>
    </div>
    <p class="mt-12 flex flex-wrap gap-x-6 gap-y-2">
      <a href="/docs/" class={link}>Get started →</a>
      <a href="/docs/router/" class={link}>Router reference →</a>
    </p>
  </section>
</BaseLayout>

<style>
  /* An ink button: paper text on ink. */
  .btn {
    background: var(--color-ink);
    color: var(--color-paper);
  }
</style>
