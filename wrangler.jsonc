{
  // Cloudflare Workers with Static Assets: the built site in dist/ is served
  // by the platform, with no Worker script of our own. `npm run build` first.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "delegation-kit-sh",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "delegation-kit.sh", "custom_domain": true }],
  "workers_dev": false,
  "observability": { "enabled": false }
}
