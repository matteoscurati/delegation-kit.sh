# Analytics (optional — leave empty to disable).
#
# Provider: Cloudflare Web Analytics. No cookies, no fingerprinting, no
# cross-site tracking; see /privacy on the site.
#
# The value is the site token from dash.cloudflare.com → Analytics & Logs →
# Web Analytics → the site's JS snippet (`data-cf-beacon='{"token": "..."}'`).
# PUBLIC_-prefixed because Astro requires that for values rendered to the
# client; the token identifies the site and is not a secret.
PUBLIC_CF_BEACON_TOKEN=
